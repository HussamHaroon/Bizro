# Bizro dashboard env — copy to .env.local and adjust.
# Leave VITE_API_BASE_URL unset to run on clearly-labeled mock fixtures
# (STATUS.md D0-3); setting it swaps every screen to the live server (schema.md §4).
# VITE_API_BASE_URL=http://localhost:8000
# VITE_MERCHANT_ID=me
# Dev-server proxy target for /api and /webhook when the backend runs elsewhere:
# VITE_API_PROXY_TARGET=http://localhost:8000
