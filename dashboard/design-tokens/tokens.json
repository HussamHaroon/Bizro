{
  "$comment": "Bizro Khata Modern tokens, machine-readable mirror of tokens.css (design.md §4.1–4.2). Server-side invoice rendering and any non-web surface read from this file.",
  "color": {
    "inkGreen": "#0B5D3B",
    "inkGreenHover": "#0E7A4C",
    "inkGreenDisabled": "#7FA392",
    "paperCream": "#F7F2E7",
    "paperCreamRaised": "#FDFAF2",
    "ledgerRed": "#A6332B",
    "ledgerRedHover": "#C04A41",
    "sealGold": "#C98A2C",
    "settledTeal": "#1F7A6C",
    "inkBlack": "#211E1A",
    "ruleLine": "#DCD3BE"
  },
  "font": {
    "body": "IBM Plex Sans, Noto Sans Urdu, system-ui, sans-serif",
    "numerals": "Zilla Slab, IBM Plex Sans, serif",
    "displayUrdu": "Noto Nastaliq Urdu, serif"
  },
  "radius": {
    "card": "6px",
    "button": "6px",
    "seal": "50%"
  },
  "motion": {
    "fast": "200ms ease-out",
    "stamp": "300ms ease-out"
  },
  "touch": {
    "minTargetPx": 48
  },
  "elevation": {
    "card": "0 1px 2px rgba(33, 30, 26, 0.06), 0 4px 14px rgba(33, 30, 26, 0.07)",
    "raise": "0 2px 4px rgba(33, 30, 26, 0.08), 0 10px 28px rgba(33, 30, 26, 0.10)"
  }
}