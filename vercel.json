{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60,
        "includeFiles": "server/**,voice-agent/**,vision-agent/**,credit-agent/**,site/dist/**,dashboard/dist/**,samples/**"
      }
    },
    { "src": "site/dist/**", "use": "@vercel/static" },
    { "src": "dashboard/dist/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/assets/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "/assets/(.*)", "dest": "/site/dist/assets/$1", "check": true },
    { "src": "/assets/(.*)", "dest": "/dashboard/dist/assets/$1", "check": true },
    { "src": "/brand/(.*)", "dest": "/site/dist/brand/$1", "check": true },
    { "src": "/brand/(.*)", "dest": "/dashboard/dist/brand/$1", "check": true },
    { "src": "/og.png", "dest": "/site/dist/og.png", "check": true },
    { "src": "/icon-64.png", "dest": "/site/dist/icon-64.png", "check": true },
    { "src": "/apple-touch-icon.png", "dest": "/site/dist/apple-touch-icon.png", "check": true },
    { "src": "/(ledger|credit|settings|simulator)", "dest": "api/index.py" },
    { "src": "/(api|webhook|health|media)/(.*)", "dest": "api/index.py" },
    { "src": "/(.*\\.(js|css|woff2?|png|jpg|svg))", "dest": "/site/dist/$1", "check": true },
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
