# Bizro environment contract — copy to .env and fill in. Canonical list lives in
# server/schema.md §5. MOCK_MODE=auto means: real calls when DASHSCOPE_API_KEY is
# present, clearly-labeled synthetic output otherwise (never pretend mock = real).

# --- Alibaba Cloud Model Studio / DashScope (HANDOFF.md ①) ---
DASHSCOPE_API_KEY=
# China-mainland default; international accounts use:
# https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_VOICE=qwen3.5-omni-plus
MODEL_OCR_VL=qwen-vl-ocr
MODEL_OCR_NEW=qwen3.5-ocr
MODEL_REASONING=qwen3.7-plus
# Which OCR adapter the Vision Audit pipeline uses. The bake-off decides
# (vision-agent/ocr-bakeoff.md); vl is the design.md §2 prior until it runs.
OCR_MODEL=vl

# --- WhatsApp Cloud API (HANDOFF.md ②) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=bizro-verify
# Optional: Meta App Secret for X-Hub-Signature-256 validation on the webhook.
# Empty (default) = validation disabled, simulator path works with zero Meta
# setup. SET THIS before exposing a real tunnel. (backend-agent addition —
# propose folding into schema.md §5 at merge; see server/README.md)
WHATSAPP_APP_SECRET=

# --- Storage / behavior ---
DATABASE_URL=sqlite:///./bizro.db
MOCK_MODE=auto
CONFIDENCE_CONFIRM_THRESHOLD=0.75
NUMERAL_STYLE=western
PORT=8000
